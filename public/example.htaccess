# Production Apache 2.4+ configuration for CodeIgniter 4.7.4 and PHP 8.5.
# The production DocumentRoot must point to this public directory.
# Keep PHP runtime settings in php.ini/PHP-FPM and verify them with
# `php spark phpini:check` after deployment.

Options -Indexes -MultiViews +FollowSymLinks
DirectoryIndex index.php
ServerSignature Off

<IfModule mod_env.c>
    SetEnv CI_ENVIRONMENT production
</IfModule>

# ----------------------------------------------------------------------
# CodeIgniter front controller
# ----------------------------------------------------------------------

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Preserve bearer/basic authentication for PHP-FPM and CGI setups.
    RewriteCond %{HTTP:Authorization} .
    RewriteRule ^ - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Send every alternate hostname directly to the canonical HTTPS domain.
    RewriteCond %{HTTP_HOST} !^lincotic\.com$ [NC]
    RewriteRule ^ https://lincotic.com%{REQUEST_URI} [R=301,L,NE]

    # Remove trailing slashes from application URLs, but not real directories.
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [R=301,L]

    # Send non-file and non-directory requests to CodeIgniter.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^([\s\S]*)$ index.php/$1 [END]
</IfModule>

<IfModule !mod_rewrite.c>
    ErrorDocument 404 /index.php
</IfModule>

# CodeIgniter handles non-www HTTP requests when
# app.forceGlobalSecureRequests is true in production. If TLS terminates at a
# reverse proxy, also register that proxy in Config\App::$proxyIPs.

# Deny direct access to hidden files if any are accidentally deployed here.
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

<IfModule mod_mime.c>
    AddType image/avif               .avif
    AddType image/webp               .webp
    AddType font/woff                .woff
    AddType font/woff2               .woff2
    AddType application/manifest+json .webmanifest
</IfModule>

# ----------------------------------------------------------------------
# Response compression
# ----------------------------------------------------------------------

<IfModule mod_filter.c>
    <IfModule mod_brotli.c>
        AddOutputFilterByType BROTLI_COMPRESS \
            text/html text/plain text/css text/csv text/xml text/vtt \
            application/javascript application/json application/ld+json \
            application/manifest+json application/wasm application/xhtml+xml \
            application/xml application/rss+xml application/atom+xml \
            image/svg+xml
    </IfModule>

    <IfModule mod_deflate.c>
        AddOutputFilterByType DEFLATE \
            text/html text/plain text/css text/csv text/xml text/vtt \
            application/javascript application/json application/ld+json \
            application/manifest+json application/wasm application/xhtml+xml \
            application/xml application/rss+xml application/atom+xml \
            image/svg+xml
    </IfModule>
</IfModule>

# Apache's compression modules add Vary: Accept-Encoding automatically.
# Binary images, fonts, archives, audio and video are intentionally excluded.

# ----------------------------------------------------------------------
# Browser caching for static files
# ----------------------------------------------------------------------

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 0 seconds"

    # CSS and JavaScript are not content-hashed yet.
    ExpiresByType text/css               "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
    ExpiresByType text/javascript        "access plus 7 days"

    # Images and media.
    ExpiresByType image/gif              "access plus 30 days"
    ExpiresByType image/jpeg             "access plus 30 days"
    ExpiresByType image/png              "access plus 30 days"
    ExpiresByType image/webp             "access plus 30 days"
    ExpiresByType image/avif             "access plus 30 days"
    ExpiresByType image/svg+xml          "access plus 30 days"
    ExpiresByType image/x-icon           "access plus 30 days"
    ExpiresByType audio/mpeg             "access plus 30 days"
    ExpiresByType audio/ogg              "access plus 30 days"
    ExpiresByType video/mp4              "access plus 30 days"
    ExpiresByType video/webm             "access plus 30 days"

    # Versioned font filenames can be cached for a year.
    ExpiresByType font/ttf               "access plus 1 year"
    ExpiresByType font/otf               "access plus 1 year"
    ExpiresByType font/woff              "access plus 1 year"
    ExpiresByType font/woff2             "access plus 1 year"
</IfModule>

# ----------------------------------------------------------------------
# Baseline production security headers
# ----------------------------------------------------------------------

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “alt-php85” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-alt-php85 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
